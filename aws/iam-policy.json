{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrainingDataAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::TODO-BUCKET",
        "arn:aws:s3:::TODO-BUCKET/tokenized/*",
        "arn:aws:s3:::TODO-BUCKET/clean/*"
      ]
    },
    {
      "Sid": "CheckpointUpload",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::TODO-BUCKET/checkpoints/*",
        "arn:aws:s3:::TODO-BUCKET/adapters/*",
        "arn:aws:s3:::TODO-BUCKET/eval/*"
      ]
    }
  ]
}
